# Repository-wide ignores.
# The Unity project keeps its own .gitignore in Unity/ (Unity's ignore rules are
# anchored to the Unity project root, so they must live there to take effect).

# Python (simu/)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
*.swp
